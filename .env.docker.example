# ==============================================================================
# Campus Nexus — Production Docker Compose Environment Template (.env)
# ==============================================================================
# Copy this file to .env before running: docker compose up -d

# --- 1. Core Django Production Settings --------------------------------------
DJANGO_SETTINGS_MODULE=campus.settings.prod
DJANGO_DEBUG=False
DJANGO_LOG_LEVEL=INFO

# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(50))'
# Minimum 50 characters required for production validation!
DJANGO_SECRET_KEY=generate-a-strong-random-50-plus-character-secret-key-here-xyz123!

# Allowed Hostnames (Comma-separated, NO wildcards, NO localhost in prod)
DJANGO_ALLOWED_HOSTS=campus-nexus.yourdomain.edu,staging.yourdomain.edu

# CSRF Trusted Origins (Must start with https://)
CSRF_TRUSTED_ORIGINS=https://campus-nexus.yourdomain.edu,https://staging.yourdomain.edu

# --- 2. Database (PostgreSQL inside Docker) -----------------------------------
POSTGRES_DB=campus_nexus_prod
POSTGRES_USER=nexus_app
# Choose a strong password for PostgreSQL:
POSTGRES_PASSWORD=replace_with_a_secure_database_password_32chars

# Application connection string pointing to Compose 'db' container
DATABASE_URL=postgres://nexus_app:replace_with_a_secure_database_password_32chars@db:5432/campus_nexus_prod

# --- 3. Distributed Cache & WebSockets (Redis inside Docker) ------------------
REDIS_URL=redis://redis:6379/0

# --- 4. Email Configuration (SMTP TLS Relay) ----------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply.campus.nexus@gmail.com
# Required: set a valid Google App Password or SMTP password (cannot be empty in prod)
EMAIL_HOST_PASSWORD=replace_with_smtp_relay_password
DEFAULT_FROM_EMAIL=Campus Nexus <noreply.campus.nexus@gmail.com>

# --- 5. Security & Reverse Proxy Headers --------------------------------------
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
DJANGO_TRUST_X_FORWARDED_FOR=True
DJANGO_TRUSTED_PROXY_IPS=127.0.0.1,172.16.0.0/12

# --- 6. WebAuthn Passkey Domain -----------------------------------------------
WEBAUTHN_RP_ID=campus-nexus.yourdomain.edu
WEBAUTHN_RP_NAME=Campus Nexus
WEBAUTHN_ALLOWED_ORIGINS=https://campus-nexus.yourdomain.edu

# --- 7. CORS (React Native & Mobile Frontend) ---------------------------------
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://campus-nexus.yourdomain.edu

# --- 8. Host Path Bindings (Optional) -----------------------------------------
# Set these if you want Compose to bind static/media directly to host directories
# STATIC_FILES_DIR=/opt/campus-nexus/staticfiles
# MEDIA_FILES_DIR=/opt/campus-nexus/media

# Copy this file to .env and fill in the values.

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key-at-least-50-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database — use sqlite for local dev, postgres for Docker/prod
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://coordinate:coordinate_dev@db:5432/coordinate

# Redis — for Django Channels (WebSocket chat)
REDIS_URL=redis://localhost:6379
# REDIS_URL=redis://redis:6379  # use this inside Docker

# Email — console backend prints to terminal (good for dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=COORDINATE <noreply@coordinate.nitsri.ac.in>

# Security — leave False for dev, set True for production HTTPS
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0

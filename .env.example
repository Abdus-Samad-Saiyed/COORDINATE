# ==============================================================================
# Campus Nexus — Local Development Environment Template (.env)
# ==============================================================================
# Copy this file to .env for local development.
# For production or Docker Compose, see .env.docker.example instead.

# --- Django Core --------------------------------------------------------------
DJANGO_SETTINGS_MODULE=campus.settings.dev
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=insecure-dev-only-secret-key-for-local-testing-replace-in-prod
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# --- Database -----------------------------------------------------------------
# SQLite for quick local development (default):
DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL local example:
# DATABASE_URL=postgres://nexus_app:localdevpass@127.0.0.1:5432/campus_nexus_prod

# --- Redis (Django Channels WebSocket Chat) -----------------------------------
REDIS_URL=redis://127.0.0.1:6379/0

# --- Email (Console backend prints emails to terminal) ------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST_USER=noreply.campus.nexus@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Campus Nexus <noreply.campus.nexus@gmail.com>

# --- Security (Disabled for local dev) ----------------------------------------
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0

# --- CORS (For React Native local dev) ----------------------------------------
CORS_ALLOW_ALL_ORIGINS=True
